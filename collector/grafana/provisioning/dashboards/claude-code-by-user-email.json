{
  "uid": "claude-code-by-user-email",
  "title": "Claude Code - By User Email",
  "tags": ["claude-code", "otel", "per-user-email"],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "user_email",
        "label": "User Email",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "user_email", "stream": "{service_name=\"claude-code\"}", "type": 1 },
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Summary",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": [],
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Total Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap cost_usd [$__range]))",
        "legendFormat": "Cost",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "#F2495C", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Total Tokens",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap output_tokens [$__range]))",
        "legendFormat": "Tokens",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "#FF9830", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "count(count by (user_email) (count_over_time({service_name=\"claude-code\", event_name=\"user_prompt\"} | user_email=~\"$user_email\" [$__range])))",
        "legendFormat": "Users",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "#5794F2", "value": null }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "title": "Cost by User",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap cost_usd [$__range]))",
        "legendFormat": "{{user_email}}"
      }],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      }
    },
    {
      "id": 5,
      "title": "Tokens by User",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap input_tokens [$__range])) + sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap output_tokens [$__range]))",
        "legendFormat": "{{user_email}}"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      }
    },

    {
      "id": 101,
      "title": "Cost",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": [],
      "collapsed": false
    },
    {
      "id": 10,
      "title": "Cost Over Time by User",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap cost_usd [$__interval]))",
        "legendFormat": "{{user_email}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 11,
      "title": "Cost by User",
      "type": "table",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap cost_usd [$__range]))",
        "legendFormat": "{{user_email}}"
      }],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["last"] } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Last", "desc": true }] } }
      ],
      "options": {
        "sortBy": [{ "displayName": "Cost (USD)", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Field" },
            "properties": [{ "id": "displayName", "value": "User Email" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last" },
            "properties": [
              { "id": "displayName", "value": "Cost (USD)" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 10 },
                { "color": "red", "value": 50 }
              ]}}
            ]
          }
        ]
      }
    },

    {
      "id": 102,
      "title": "Tokens",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": [],
      "collapsed": false
    },
    {
      "id": 20,
      "title": "Tokens Over Time by User",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap input_tokens [$__interval])) + sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap output_tokens [$__interval]))",
        "legendFormat": "{{user_email}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 21,
      "title": "Tokens by User",
      "type": "table",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap input_tokens [$__range])) + sum by (user_email) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | user_email=~\"$user_email\" | unwrap output_tokens [$__range]))",
        "legendFormat": "{{user_email}}"
      }],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["last"] } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Last", "desc": true }] } }
      ],
      "options": {
        "sortBy": [{ "displayName": "Tokens", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Field" },
            "properties": [{ "id": "displayName", "value": "User Email" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last" },
            "properties": [
              { "id": "displayName", "value": "Tokens" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 10000 },
                { "color": "green", "value": 50000 }
              ]}}
            ]
          }
        ]
      }
    }
  ]
}
