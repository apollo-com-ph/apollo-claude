{
  "uid": "claude-code-overview",
  "title": "Claude Code Overview",
  "tags": ["claude-code", "otel", "overview"],
  "timezone": "browser",
  "refresh": "30m",
  "schemaVersion": 39,
  "time": { "from": "now-7d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Active Developers Today",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "count(count by (developer) (count_over_time({service_name=\"claude-code\", event_name=\"user_prompt\"} | developer=~\".+\" [24h])))",
        "legendFormat": "Developers",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": { "steps": [{ "color": "#5794F2", "value": null }] }
        }
      }
    },
    {
      "id": 5,
      "title": "Total Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap cost_usd [$__range]))",
        "legendFormat": "Cost",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": { "steps": [{ "color": "#F2495C", "value": null }] }
        }
      }
    },
    {
      "id": 8,
      "title": "Total Tokens",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap output_tokens [$__range]))",
        "legendFormat": "Tokens",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "decimals": 0,
          "thresholds": { "steps": [{ "color": "#FF9830", "value": null }] }
        }
      }
    },
    {
      "id": 6,
      "title": "Active Repositories Today",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "count(sum by (repository) (count_over_time({service_name=\"claude-code\", event_name=\"user_prompt\"} | developer=~\".+\" [24h])))",
        "legendFormat": "Repositories",
        "queryType": "instant"
      }],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": { "steps": [{ "color": "#73BF69", "value": null }] }
        }
      }
    },
    {
      "id": 10,
      "title": "Daily Active Developers",
      "type": "barchart",
      "timeFrom": "14d",
      "maxDataPoints": 14,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "count(sum by (developer) (count_over_time({service_name=\"claude-code\", event_name=\"user_prompt\"} | developer=~\".+\" [1d])))",
        "legendFormat": "Active Developers"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#5794F2" }
        }
      },
      "options": {
        "barWidth": 0.6,
        "fillOpacity": 80,
        "gradientMode": "none",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "text": { "valueSize": 8 }
      }
    },
    {
      "id": 12,
      "title": "Daily Active Repositories",
      "type": "barchart",
      "timeFrom": "14d",
      "maxDataPoints": 14,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "count(sum by (repository) (count_over_time({service_name=\"claude-code\", event_name=\"user_prompt\"} | developer=~\".+\" [1d])))",
        "legendFormat": "Active Repositories"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" }
        }
      },
      "options": {
        "barWidth": 0.6,
        "fillOpacity": 80,
        "gradientMode": "none",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "text": { "valueSize": 8 }
      }
    },

    {
      "id": 37,
      "title": "Daily Cost (USD)",
      "type": "barchart",
      "timeFrom": "14d",
      "maxDataPoints": 14,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap cost_usd [1d]))",
        "legendFormat": "Cost"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#F2495C" },
          "unit": "currencyUSD",
          "decimals": 0
        }
      },
      "options": {
        "barWidth": 0.6,
        "fillOpacity": 80,
        "gradientMode": "none",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "text": { "valueSize": 8 }
      }
    },

    {
      "id": 36,
      "title": "Daily Tokens",
      "type": "barchart",
      "timeFrom": "14d",
      "maxDataPoints": 14,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap input_tokens [1d])) + sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap output_tokens [1d]))",
        "legendFormat": "Tokens"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#FF9830" },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "barWidth": 0.6,
        "fillOpacity": 80,
        "gradientMode": "none",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "text": { "valueSize": 8 }
      }
    },

    {
      "id": 35,
      "title": "Prompts Without Repository (check OTEL setup)",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (developer) (count_over_time({service_name=\"claude-code\", event_name=\"user_prompt\"} | developer=~\".+\" | repository = \"\" [$__range]))",
        "legendFormat": "{{developer}}"
      }],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["last"] } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Last", "desc": true }] } }
      ],
      "options": {
        "sortBy": [{ "displayName": "Prompts", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "decimals": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Field" },
            "properties": [{ "id": "displayName", "value": "Developer" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last" },
            "properties": [{ "id": "displayName", "value": "Prompts" }]
          }
        ]
      }
    },
    {
      "id": 31,
      "title": "Tokens by Developer",
      "type": "table",
      "gridPos": { "h": 20, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (developer) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap input_tokens [$__range])) + sum by (developer) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap output_tokens [$__range]))",
        "legendFormat": "{{developer}}"
      }],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["last"] } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Last", "desc": true }] } }
      ],
      "options": {
        "sortBy": [{ "displayName": "Tokens", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Field" },
            "properties": [{ "id": "displayName", "value": "Developer" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last" },
            "properties": [
              { "id": "displayName", "value": "Tokens" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 10000 },
                { "color": "green", "value": 50000 }
              ]}}
            ]
          }
        ]
      }
    },
    {
      "id": 33,
      "title": "Tokens by Repository",
      "type": "table",
      "gridPos": { "h": 20, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "sum by (repository) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap input_tokens [$__range])) + sum by (repository) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | developer=~\".+\" | model=~\".+\" | unwrap output_tokens [$__range]))",
        "legendFormat": "{{repository}}"
      }],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["last"] } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Last", "desc": true }] } }
      ],
      "options": {
        "sortBy": [{ "displayName": "Tokens", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Field" },
            "properties": [{ "id": "displayName", "value": "Repository" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last" },
            "properties": [
              { "id": "displayName", "value": "Tokens" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 10000 },
                { "color": "green", "value": 50000 }
              ]}}
            ]
          }
        ]
      }
    }
  ]
}
